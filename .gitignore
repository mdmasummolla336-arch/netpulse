data/*.db.*
data/*.sqlite
data/*.sqlite-*
backups/
backup/
backup-before-*/
*.before-*
**/*.before-*
*.bak-*
**/*.bak-*
*.backup-*
**/*.backup-*
__pycache__/
**/__pycache__/
